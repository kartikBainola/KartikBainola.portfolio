# ── Contact form (GitHub Pages + Cloudflare Worker + Resend) ─────────────
#
# GitHub Pages is static — Resend keys must NOT go in the browser.
# Deploy workers/contact, then set the public worker URL below / in GitHub Actions.
#
# 1. cd workers/contact
# 2. npx wrangler login
# 3. npx wrangler secret put RESEND_API_KEY
# 4. npx wrangler deploy
# 5. Copy the worker URL into NEXT_PUBLIC_CONTACT_API_URL
# 6. GitHub → Settings → Secrets and variables → Actions:
#      NEXT_PUBLIC_CONTACT_API_URL = https://portfolio-contact.<your-subdomain>.workers.dev

# Public (safe to expose — baked into the static site at build time)
NEXT_PUBLIC_CONTACT_API_URL=https://portfolio-contact.YOUR_SUBDOMAIN.workers.dev

# Used only by the Cloudflare Worker (wrangler secret / CF dashboard) — not by Next.js on Pages
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL=kartikbainola1303@gmail.com
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>
